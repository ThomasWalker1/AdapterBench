__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
upstream/
runs/
train_outputs/
wandb/
.venv/

# Regeneratable binary adapter weights written by `adapterbench run`/`peft-smoke`
# (results.jsonl/.csv/loss_curves.json metrics stay tracked)
results/**/adapters/


# Restart-safe training checkpoints (model+optimizer): NIAH `ckpt_*.pt`, image-domain
# `checkpoint.pt`, and every other .pt under results/ (~0.5-1.2GB each) - never commit.
# Metrics (results.jsonl/.csv, history.json, loss_curves.json) stay tracked.
results/**/*.pt
results/**/*.pt.tmp

# Run stdout logs are disposable (HF warnings + progress); the tracked record is the
# derived results.jsonl/.csv/history.json, never the log. Never commit logs under results/.
results/**/*.log
results/*.log
