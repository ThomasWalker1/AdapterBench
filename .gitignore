__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
upstream/
runs/
train_outputs/
wandb/
.venv/

# Experiment outputs under results/ are exploration scratch and are NOT committed by default:
# they are numerous and regenerable, and most runs are ad-hoc rather than curated leaderboard
# records. Result directories committed before this policy stay tracked (gitignore does not
# untrack). To commit a canonical leaderboard record, force-add just its metrics, e.g.
#   git add -f results/<dir>/results.jsonl results/<dir>/history.json
# The rules below still apply to any force-added directory, so checkpoints (large, ~0.5-1.2GB),
# their write-temps, logs (disposable HF/progress output), and adapter weights are never
# committed even then.
results/
results/**/adapters/
results/**/*.pt
results/**/*.pt.tmp
results/**/*.log
results/*.log
