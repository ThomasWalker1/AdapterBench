[
  {
    "schema_version": 1,
    "trial_id": "text_to_lora_gemma2b--lora_r8_t2l--8f5ba04b6fbd",
    "setup": {
      "schema_version": 1,
      "name": "text_to_lora_gemma2b",
      "description": "Text-to-LoRA reconstruction protocol using natural-language task descriptions and a Gemma-2-2B-IT interpreter.",
      "protocol": "text_to_lora",
      "availability": "runnable",
      "runner": "upstream/SakanaAI/text-to-lora",
      "sources": [
        {
          "name": "paper",
          "uri": "https://openreview.net/forum?id=zWskCdu3QA",
          "revision": null
        },
        {
          "name": "code",
          "uri": "https://github.com/SakanaAI/text-to-lora",
          "revision": "main"
        },
        {
          "name": "released_checkpoint",
          "uri": "https://huggingface.co/SakanaAI/text-to-lora",
          "revision": "6e571eda2188b216f027263cd28c99c0fdcf2fa3"
        }
      ],
      "models": {
        "condition_encoder": {
          "model_id": "Alibaba-NLP/gte-large-en-v1.5",
          "revision": null,
          "frozen": true,
          "dtype": "bfloat16"
        },
        "interpreter": {
          "model_id": "google/gemma-2-2b-it",
          "revision": null,
          "frozen": true,
          "dtype": "bfloat16"
        }
      },
      "conditioning": {
        "kind": "task_description",
        "encoder": "Alibaba-NLP/gte-large-en-v1.5",
        "pooling": "upstream_text_to_lora",
        "fields": [
          "task_description"
        ]
      },
      "dataset": {
        "source": "upstream",
        "dataset_id": "SakanaAI/text-to-lora/configs/hyper_lora_decontam_lol_tasks.yaml",
        "revision": null,
        "train_split": "train_tasks_479",
        "validation_split": "upstream_validation",
        "test_splits": [
          "seen_benchmarks",
          "unseen_tasks"
        ],
        "task_id_field": "dataset_name",
        "family_field": "benchmark_family",
        "condition_field": "task_description",
        "input_field": "prompt",
        "target_field": "answer",
        "holdout_unit": "task"
      },
      "objective": {
        "kind": "reconstruction",
        "downstream_weight": 0.0,
        "reconstruction_weight": 1.0,
        "oracle_adapter_source": "upstream_task_specific_adapters"
      },
      "evaluation": {
        "primary_metric": "benchmark_accuracy_mean",
        "metrics": [
          "accuracy",
          "exact_match",
          "pass_at_1",
          "adapter_reconstruction_mse",
          "generation_latency"
        ],
        "baselines": [
          "frozen_interpreter",
          "interpreter_with_icl",
          "oracle_adapter",
          "released_t2l"
        ],
        "report_by": [
          "task",
          "seen_vs_unseen",
          "representation"
        ],
        "generation": {
          "use_icl": true,
          "num_fewshot": 3
        }
      },
      "runtime": {
        "launcher": "torchrun",
        "num_processes": 8,
        "mixed_precision": "bf16",
        "gradient_checkpointing": false
      },
      "fixed_controls": [
        "gte-large-en-v1.5 condition encoder",
        "frozen Gemma-2-2B-IT interpreter",
        "479-task training split and unseen-task split",
        "task-description variants",
        "hypernetwork hidden architecture",
        "reconstruction optimizer and update count",
        "downstream evaluator and decoding settings"
      ],
      "notes": [
        "The released Gemma adapter uses rank 8 RS-LoRA, alpha 16, dropout 0.05 on q_proj and v_proj.",
        "A second manifest should use the upstream SFT/downstream objective; it must not be pooled with reconstruction runs."
      ]
    },
    "adapter": {
      "schema_version": 1,
      "name": "lora_r8_t2l",
      "family": "lora",
      "implementation": "peft",
      "output_structure": "Generated rank-8 RS-LoRA A/B factors.",
      "target_modules": [
        "q_proj",
        "v_proj"
      ],
      "hyperparameters": {
        "r": 8,
        "lora_alpha": 16,
        "lora_dropout": 0.05,
        "use_rslora": true,
        "bias": "none"
      },
      "compatible_objectives": [
        "downstream",
        "reconstruction",
        "hybrid"
      ],
      "supports_batched_generation": true,
      "notes": [
        "Exact adapter configuration from the released Text-to-LoRA Gemma checkpoint."
      ]
    }
  },
